# MyPocketOS - 最小構成パッケージリスト
# 各パッケージは Debian 13 (trixie) の main / contrib / non-free-firmware に
# 存在することを apt-cache show で確認済み。

# ---- Live起動 (live-boot / live-config) ----
live-boot
live-config
live-config-systemd

# ---- X.Org (最小構成) ----
xserver-xorg
xserver-xorg-video-all
xserver-xorg-input-all
xinit
dbus-x11

# ---- デスクトップ環境: Openbox ----
openbox
tint2
lightdm
lightdm-gtk-greeter
pcmanfm
lxterminal

# ---- ネットワーク ----
network-manager
network-manager-gnome

# ---- PolicyKit 認証エージェント ----
lxpolkit

# ---- ロケール / キーボード / タイムゾーン ----
locales
keyboard-configuration
console-setup
tzdata

# ---- 日本語フォント (Noto CJK) ----
fonts-noto-cjk

# ---- 日本語入力 (Fcitx5-Mozc) ----
fcitx5
fcitx5-mozc
fcitx5-frontend-gtk3

# ---- 仮想環境統合（SPICE） ----
spice-vdagent

# ---- 音声 (PipeWire) ----
pipewire-audio
pavucontrol
pasystray
pamixer

# ---- zram (圧縮スワップ) ----
zram-tools

# ---- アプリメニュー (jgmenu) ----
jgmenu

# ---- システム情報表示 (Conky) ----
conky-std

# ---- 電源・セッション確認ダイアログ (GTK3、既存GTK3環境と親和性が高い) ----
yad

# ---- 永続化基盤: パーティション/ファイルシステム作成 ----
# (今回はテストVMでの手動初期化用。将来のGUI永続領域作成機能の基盤)
parted
e2fsprogs
