#!/bin/sh
#
# MyPocketOS - NetworkManager dispatcher: 接続確立時にConkyを再起動する
#
# 背景 (2026-09-07、3度目の実機不具合修正):
# Conkyのネットワーク表示 (${downspeed ${gw_iface}}/${upspeed ${gw_iface}}、
# 取得ロジック自体は実機で正常動作を確認済み) が、実機では起動直後
# Wi-Fi接続後・通信中でもDown/Upが常に0Bのまま変化しない不具合が確認
# された。実機での切り分けにより、原因はネットワーク取得ロジックでは
# なく、Conkyがネットワーク接続前に起動した場合、そのConkyプロセスの
# 生存中はネットワークデバイスの内部状態が更新されず、後から接続しても
# 反映されないという、Conky自身の起動タイミング/初期化の問題であると
# 判明した。実機で、稼働中のConkyプロセスを完全終了させてから再起動
# すると正しく動作することを確認済み。
#
# 対応方針: Conky側の取得ロジックはこれ以上複雑化せず、「ネットワーク
# 接続が確立した」タイミングでConkyを1回再起動するだけに留める。
# NetworkManagerは接続状態が変化するたびに、dispatcher.d配下の実行可能
# スクリプトを"INTERFACE ACTION"という2引数でroot権限から呼び出す
# (man NetworkManager(8) "Dispatcher scripts")。本スクリプトは、この
# イベント駆動の仕組みだけに依存し、毎秒のポーリング・新規の常駐
# watchdog・新規systemdサービスは一切追加しない。特定のネットワーク
# インターフェース名 ($1) は判定に使用しない (どのインターフェースが
# upしても同じ処理を行う)。
#
# 稼働中のConkyプロセス自身の環境 (DISPLAY・XAUTHORITY・HOME) を
# /proc/<pid>/environ から読み取って再現するため、DISPLAY等を
# 固定文字列でハードコードしない。MyPocketOS Live環境のユーザー名は
# 既存のREADME (「GUIによる永続領域作成」節) でも前提としている
# 固定のLiveユーザー`user`のみを対象とする。
#
# 追記 (2026-09-08、4commit目入りISOの実機確認結果を踏まえた5度目の
# 修正): 4commit目の時点では、DISPLAY・XAUTHORITY・HOMEのみを引き継いで
# いたため、再起動後のConkyで日本語表示が全面的に文字化けし
# (LANG未引き継ぎ)、起動モードが常にUnknownになる
# (XDG_RUNTIME_DIR未引き継ぎ。mypocketos-boot-mode.luaが
# $XDG_RUNTIME_DIR/mypocketos-boot-mode.txt を参照できないため、
# 設計どおりfail-closeでUnknownになっていた) ことが実機で確認された。
# 同じ実機で、ユーザー自身が端末から`conky -p 3 -U &`で再起動すると
# (シェル経由でユーザーセッションの環境をそのまま継承するため)
# 日本語表示・起動モードとも正常に復帰することも確認された。
#
# この事実を踏まえ、既存のDISPLAY・XAUTHORITY・HOMEに加えて、LANG・
# XDG_RUNTIME_DIRと、あらかじめ列挙した既知のLC_*変数(LC_ALL・
# LC_CTYPE・LC_MESSAGES・LC_TIME・LC_NUMERIC・LC_COLLATE・
# LC_MONETARY)を、稼働中のConky自身の/proc/<pid>/environから個別に
# 明示的に読み取り、存在する場合のみ再起動後のConkyへ引き継ぐ。
# environの内容を無条件・無制限にまるごとコピーする実装にはしていない
# (未知の変数を予期せず引き継がないため)。LANG・XDG_RUNTIME_DIR・
# LC_*が取得できない場合でも、DISPLAYさえ取得できれば再起動自体は
# 行う (fail-safe。日本語表示・起動モード表示は劣化しうるが、
# ネットワーク表示の0B固定という主要な不具合は解消される)。
# DISPLAYのみ、取得できない場合は再起動自体を行わない (fail-close、
# 既存方針のまま)。
#
set -eu

ACTION="${2:-}"

# 接続が確立した("up")場合のみ処理する。切断時 (down等) は、Conky側の
# ${if_match "${gw_iface}" != "none"}が毎更新サイクルで正しく「未接続」
# へ切り替わるため、再起動は不要。
[ "${ACTION}" = "up" ] || exit 0

LIVE_USER="user"

# 対象ユーザーで稼働中のconkyプロセスが無ければ何もしない
# (まだ起動シーケンスでConkyが起動していない、またはユーザーが手動で
# 終了させている場合等はそのまま関与しない)。
CONKY_PID="$(pgrep -u "${LIVE_USER}" -x conky 2>/dev/null | head -n1)" || true
[ -n "${CONKY_PID}" ] || exit 0

ENVIRON_FILE="/proc/${CONKY_PID}/environ"
[ -r "${ENVIRON_FILE}" ] || exit 0

# 稼働中のConky自身が実際に使っているDISPLAY/XAUTHORITY/HOME/LANG/
# XDG_RUNTIME_DIR/LC_*をそのまま再利用する (推測・ハードコードしない)。
# kill前に (プロセスが生存している間に) すべて読み取っておく
# (/proc/<pid>/environはプロセス終了後には読めなくなるため)。
CONKY_DISPLAY="$(tr '\0' '\n' < "${ENVIRON_FILE}" | sed -n 's/^DISPLAY=//p' | head -n1)"
CONKY_XAUTHORITY="$(tr '\0' '\n' < "${ENVIRON_FILE}" | sed -n 's/^XAUTHORITY=//p' | head -n1)"
CONKY_HOME="$(tr '\0' '\n' < "${ENVIRON_FILE}" | sed -n 's/^HOME=//p' | head -n1)"
CONKY_LANG="$(tr '\0' '\n' < "${ENVIRON_FILE}" | sed -n 's/^LANG=//p' | head -n1)"
CONKY_XDG_RUNTIME_DIR="$(tr '\0' '\n' < "${ENVIRON_FILE}" | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n1)"

# LC_*は、環境変数を無制限にまるごとコピーしないよう、既知の変数名を
# 明示的に列挙したリストのみを対象とする (未知の変数を予期せず引き継が
# ない)。ここで (kill前に) 値を確定させ、"NAME=VALUE" の形で保持する。
LC_ENV_ARGS=""
for lc_name in LC_ALL LC_CTYPE LC_MESSAGES LC_TIME LC_NUMERIC LC_COLLATE LC_MONETARY; do
	lc_value="$(tr '\0' '\n' < "${ENVIRON_FILE}" | sed -n "s/^${lc_name}=//p" | head -n1)"
	[ -z "${lc_value}" ] || LC_ENV_ARGS="${LC_ENV_ARGS}${lc_name}=${lc_value}
"
done

# DISPLAYが取得できない場合は、どこにも再起動できないため何もしない
# (fail-close。誤ったDISPLAYを推測して起動を試みない)。LANG・
# XDG_RUNTIME_DIR・LC_*は、取得できなくても再起動自体は行う
# (fail-safe。上記コメント参照)。
[ -n "${CONKY_DISPLAY}" ] || exit 0

kill "${CONKY_PID}" 2>/dev/null || true

# -U (--unique) は「既に別のConkyプロセスが起動していれば新規起動を
# 拒否する」動作のため、旧プロセスの終了を待たずに再起動を試みると
# 新しいConkyが起動できず、Conky自体が消えたままになる。プロセスが
# 実際に終了するまで短時間 (最大2秒) 待ってから再起動する。
i=0
while [ "${i}" -lt 10 ]; do
	kill -0 "${CONKY_PID}" 2>/dev/null || break
	sleep 0.2
	i=$((i + 1))
done

set -- env "DISPLAY=${CONKY_DISPLAY}"
[ -z "${CONKY_XAUTHORITY}" ] || set -- "$@" "XAUTHORITY=${CONKY_XAUTHORITY}"
[ -z "${CONKY_HOME}" ] || set -- "$@" "HOME=${CONKY_HOME}"
[ -z "${CONKY_LANG}" ] || set -- "$@" "LANG=${CONKY_LANG}"
[ -z "${CONKY_XDG_RUNTIME_DIR}" ] || set -- "$@" "XDG_RUNTIME_DIR=${CONKY_XDG_RUNTIME_DIR}"

# kill前に確定させたLC_*の "NAME=VALUE" 行を、1行ずつ引数として追加する。
if [ -n "${LC_ENV_ARGS}" ]; then
	old_ifs="${IFS}"
	IFS='
'
	for lc_arg in ${LC_ENV_ARGS}; do
		[ -z "${lc_arg}" ] || set -- "$@" "${lc_arg}"
	done
	IFS="${old_ifs}"
fi

# 追記 (2026-09-11、Wi-Fi接続時のConky再表示遅延に関するUX改善):
# autostart側 (~/.config/openbox/autostart) の`conky -p 3 -U`は、ログイン
# セッション開始直後、X/tint2等の他の常駐プログラムがまだ起動処理中で
# あることを想定した安全マージンとして`-p 3`(起動後3秒間は何も描画
# しない)を採用している。本dispatcherによる再起動は、NetworkManagerが
# 接続確立("up")を通知した後にのみ発火し、その時点でXサーバー・
# セッション・パネル等は既に安定稼働済みであるため、起動直後と同じ
# 3秒の安全マージンは不要と判断した。`-p`の値のみを`3`から`1`へ短縮する
# (autostart側の`-p 3`はここでは変更しない、`-U`はプロセス多重起動防止
# のため維持する)。ネットワーク取得ロジック・環境変数引き継ぎ・
# kill待ちループ(下記)は変更していない。
set -- "$@" conky -p 1 -U

runuser -u "${LIVE_USER}" -- "$@" >/dev/null 2>&1 &

exit 0
