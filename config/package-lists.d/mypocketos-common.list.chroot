# MyPocketOS - 全edition共通の最小構成パッケージリスト
# Base版はこのファイルのみ、Standard版はこのファイル+
# mypocketos-standard.list.chroot を使う (積み上げ式)。
# ビルド時、scripts/build.sh がeditionに応じて必要なファイルだけを
# config/package-lists/ へ一時的にコピーする (このディレクトリ
# config/package-lists.d/ 自体はlive-buildの読み込み対象外)。
# 各パッケージは Debian 13 (trixie) の main / contrib / non-free-firmware に
# 存在することを apt-cache show で確認済み。

# ---- Live起動 (live-boot / live-config) ----
live-boot
live-config
live-config-systemd

# ---- X.Org (最小構成) ----
xserver-xorg
xserver-xorg-video-all
xserver-xorg-input-all
xinit
dbus-x11

# ---- タッチパッド設定GUI用 (XInputプロパティの読み書き) ----
xinput

# ---- デスクトップ環境: Openbox ----
openbox
tint2
lightdm
lightdm-gtk-greeter
pcmanfm
lxterminal

# ---- ネットワーク ----
network-manager
network-manager-gnome

# ---- PolicyKit 認証エージェント ----
lxpolkit

# ---- ロケール / キーボード / タイムゾーン ----
locales
keyboard-configuration
console-setup
tzdata

# ---- 日本語フォント (Noto CJK) ----
fonts-noto-cjk

# ---- 日本語入力 (Fcitx5-Mozc) ----
fcitx5
fcitx5-mozc
fcitx5-frontend-gtk3

# ---- 仮想環境統合（SPICE） ----
spice-vdagent

# ---- 音声 (PipeWire) ----
pipewire-audio
pavucontrol
pasystray
pamixer

# ---- zram (圧縮スワップ) ----
zram-tools

# ---- アプリメニュー (jgmenu) ----
jgmenu

# ---- システム情報表示 (Conky) ----
conky-std

# ---- 電源・セッション確認ダイアログ (GTK3、既存GTK3環境と親和性が高い) ----
yad

# ---- 永続化基盤: パーティション/ファイルシステム作成 ----
# (今回はテストVMでの手動初期化用。将来のGUI永続領域作成機能の基盤)
parted
e2fsprogs

# ---- 追加アプリ導入 (Flatpak) ----
# ユーザーが後からアプリを追加する際の正式な方法として`flatpak --user`を
# 推奨する。Flathub等のremoteはここでは登録しない(ユーザー自身が
# `flatpak --user remote-add`で追加する想定)。GUIソフトウェアセンター
# (gnome-software等)は含めない。`--user`でインストールしたアプリ・
# ランタイム・remote設定・ユーザーデータ(~/.var/app/)はいずれも/home配下
# に保存されるため、既存のPersistence(/home)でそのまま永続化される。
flatpak

# ---- GUIインストーラー (Calamares、初回リリース正式機能) ----
# `calamares`・`calamares-settings-debian`はDebian公式パッケージ。
# MyPocketOS独自の設定は`config/includes.chroot/etc/calamares/`配下
# (settings.conf・welcome.conf・partition.conf・finished.conf・
# locale.conf)、および専用ヘルパースクリプト
# (`mypocketos-installer-menu-state`・`mypocketos-installer-reboot`・
# `mypocketos-install-media-removal`)として追加済みであり、初回
# リリースの正式機能として実装・確認済み(専用ディスクへのインストール
# を正式サポート範囲とする。Dual Boot・既存OSとの共存インストールは
# 対象外。詳細は`mypocketos-specification-2026-08-31.md` 10節を参照)。
# calamares-settings-debianはcryptsetup等を依存として引き込むため、
# ISOサイズ・既存hook(1010-enable-cryptsetup.hook.chroot)への影響を
# 把握したうえで採用している。
calamares
calamares-settings-debian
